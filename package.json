{
  "name": "nyra-lang",
  "displayName": "NyraLang",
  "description": "Syntax, themes, LSP, and debug for Nyra (.ny / .ni / .nk)",
  "version": "0.24.7",
  "publisher": "nyra",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nyra",
    "onCommand:nyra.showOutput",
    "onCommand:nyra.restartAnalyzer",
    "onCommand:nyra.debug.currentFile",
    "onCommand:nyra.debug.initWorkspace",
    "onTaskType:nyra",
    "onCommand:nyra.selectSdk",
    "onCommand:nyra.installSdk"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "scripts": {
    "check": "node --check extension.js && node --check debugSupport.js && node --check analyzerPath.js && node --check windowToolchain.js && node --check sdkDiscovery.js && node --check sdkInstaller.js && node --check sdkSupport.js",
    "test": "npm run check && node scripts/smoke-analyzer-path.js && node scripts/smoke-extension-lifecycle.js && node scripts/smoke-debug-support.js && node scripts/smoke-sdk-setup.js"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nyra",
        "aliases": [
          "Nyra",
          "nyra"
        ],
        "extensions": [
          ".ny",
          ".ni",
          ".nk"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/file-icon-light.png",
          "dark": "./assets/file-icon-dark.png"
        }
      }
    ],
    "configuration": {
      "title": "Nyra",
      "properties": {
        "nyra.sdkPath": {
          "type": "string",
          "default": "",
          "description": "SDK or compiler checkout root for this VS Code window. Empty searches the workspace, NYRA_SDK, PATH and known installation folders. Use Nyra: Select SDK or Nyra: Install SDK to configure it."
        },
        "nyra.analyzerPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the language server. Empty uses the selected SDK's host-specific nyra-analyzer binary."
        },
        "nyra.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the compiler for debug builds. Empty uses the selected SDK's host-specific nyrac binary."
        },
        "nyra.debugAdapter": {
          "type": "string",
          "enum": [
            "auto",
            "lldb",
            "cppdbg"
          ],
          "default": "auto",
          "description": "Native debugger: auto (prefer CodeLLDB), lldb, or cppdbg (Microsoft C/C++)."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "nyra",
        "required": [],
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "debug",
              "release"
            ],
            "description": "Build profile (debug uses DWARF from the LLVM pipeline)"
          },
          "file": {
            "type": "string",
            "description": "Entry .ny path; omit to use ${file}"
          },
          "label": {
            "type": "string",
            "description": "Task label shown in VS Code"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "nyra.restartAnalyzer",
        "title": "Nyra: Restart Analyzer"
      },
      {
        "command": "nyra.showOutput",
        "title": "Nyra: Show Output"
      },
      {
        "command": "nyra.debug.currentFile",
        "title": "Nyra: Debug Current File"
      },
      {
        "command": "nyra.debug.initWorkspace",
        "title": "Nyra: Initialize Debug Workspace"
      },
      {
        "command": "nyra.selectSdk",
        "title": "Nyra: Select SDK"
      },
      {
        "command": "nyra.installSdk",
        "title": "Nyra: Install SDK"
      }
    ],
    "grammars": [
      {
        "language": "nyra",
        "scopeName": "source.nyra",
        "path": "./syntaxes/nyra.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Nyra Slate Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/nyra-slate-dark-color-theme.json"
      },
      {
        "label": "Nyra Mist Light",
        "uiTheme": "vs",
        "path": "./themes/nyra-mist-light-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "nyra-seti",
        "label": "Nyra (Seti)",
        "path": "./themes/nyra-seti-icon-theme.json"
      }
    ]
  },
  "dependencies": {
    "tar": "^7.5.22",
    "vscode-languageclient": "^9.0.1",
    "yauzl": "^3.4.0"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nylang/nylang-ide-vscode.git"
  }
}
